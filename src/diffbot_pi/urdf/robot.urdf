<?xml version="1.0"?>
<robot name="diffbot_pi">
  <link name="base_link"><visual><geometry><box size="0.25 0.20 0.10"/></geometry></visual></link>
  <link name="left_wheel_link"><visual><geometry><cylinder radius="0.033" length="0.025"/></geometry></visual></link>
  <link name="right_wheel_link"><visual><geometry><cylinder radius="0.033" length="0.025"/></geometry></visual></link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="0 0.1225 -0.05" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="0 -0.1225 -0.05" rpy="-1.57079632679 0 0"/><axis xyz="0 0 1"/></joint>
  <link name="laser"><visual><geometry><cylinder radius="0.035" length="0.04"/></geometry></visual></link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="0.08 0 0.10" rpy="0 0 0"/></joint>
  <link name="ultrasonic_front_link"/>
  <joint name="sonar_joint" type="fixed"><parent link="base_link"/><child link="ultrasonic_front_link"/><origin xyz="0.12 0 0" rpy="0 0 0"/></joint>
</robot>
